# 서버 설정
NODE_ENV=production
PORT=3000
SESSION_SECRET=your-session-secret-change-this

# Google Sheets 연동
GOOGLE_CREDENTIALS_PATH=./credentials.json
SHEET_ID_SALES=your-sales-spreadsheet-id
SHEET_ID_SUBJECTS=your-subjects-spreadsheet-id
SHEET_RANGE_SALES=매출현황!A2:I
SHEET_RANGE_TOTAL=전사목표!A2:C
SHEET_RANGE_SUBJECTS=시험대상자현황!A2:G
POLLING_INTERVAL=30000

# Q4 데이터 소스 (sqlite 또는 sheets)
SUBJECT_DATA_SOURCE=sqlite
