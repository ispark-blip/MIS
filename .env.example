# 서버 설정
NODE_ENV=development
PORT=3000
# 바인딩할 호스트 (0.0.0.0 = 모든 네트워크 인터페이스 → 로컬 IP로 접속 가능)
HOST=0.0.0.0
SESSION_SECRET=your-session-secret-change-this

# Google Sheets 연동
# 1) 서비스 계정 JSON 키를 프로젝트 루트에 credentials.json으로 저장
# 2) 아래 SHEET_ID_* 에 각 스프레드시트 ID 입력 (URL의 /d/{ID}/edit 부분)
# 3) 해당 시트를 서비스 계정 이메일(xxx@xxx.iam.gserviceaccount.com)에 "뷰어" 권한으로 공유
GOOGLE_CREDENTIALS_PATH=./credentials.json

# 매출 (Q1, Q2) - 월 단위 입력, 분기/연간 자동 집계
# 컬럼: 연도 | 월 | 부서명 | 연구소 | 월목표 | 월실적
SHEET_ID_SALES=
SHEET_RANGE_SALES=매출현황!A2:F

# 시험건수 (Q3)
# 컬럼: 날짜 | 연구소 | 부서 | 시험유형 | 건수 | 입력자 | 비고
SHEET_ID_TESTCOUNTS=
SHEET_RANGE_TESTCOUNTS=시험건수!A2:G

# 시험대상자 인원수 (Q4)
# 컬럼: 날짜 | 연구소 | 부서 | 인원수 | 과제명 | (선택) | (선택)
SHEET_ID_SUBJECTS=
SHEET_RANGE_SUBJECTS=시험대상자현황!A2:G

# 폴링 간격 (ms)
POLLING_INTERVAL=30000
